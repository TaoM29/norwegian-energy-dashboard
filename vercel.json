{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python scripts/fetch_snapshot.py",
  "regions": ["fra1"],
  "functions": {
    "server.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,tests/**,docs/**,notebooks/**,.agents/**,.github/**,.git/**,.vercel-deploy/**,data/fixture/**,data/*.csv,scripts/**}"
    }
  }
}
